{
  "name": "dumpr-app",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --names NEXT,API --prefix-colors blue,green \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "next dev",
    "build": "next build",
    "build:backend": "npx -y tsc -p server/tsconfig.json",
    "build:all": "npm run build:backend && next build",
    "start": "concurrently \"next start\" \"node dist/server/server.js\"",
    "start:frontend": "next start",
    "start:backend": "node dist/server/server.js",
    "lint": "eslint",
    "test": "jest",
    "seed:admin": "npx -y tsx scripts/seed-admin.ts",
    "seed:day3": "npx -y tsx scripts/seed-day3.ts",
    "verify:day3": "npx -y tsx scripts/verify-day3.ts",
    "verify:day4": "npx -y tsx scripts/verify-day4.ts",
    "verify:day5": "npx -y tsx scripts/verify-day5.ts",
    "verify:day6": "npx -y tsx scripts/verify-day6.ts",
    "verify:day7": "npx -y tsx scripts/verify-day7.ts",
    "verify:day8": "npx -y tsx scripts/verify-day8.ts",
    "cleanup:retention": "npx -y tsx scripts/cleanup-retention.ts"
  },
  "dependencies": {
    "@studio-freight/lenis": "^1.0.42",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.41.0",
    "multer": "^2.0.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uuid": "^11.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.2",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.4",
    "typescript": "^5"
  }
}
