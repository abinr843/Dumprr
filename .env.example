# ============================================================
# DUMPR — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ------------------------------------
# Supabase — Public (safe for browser)
# ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------
# Supabase — Server-Only (CRITICAL: NEVER expose to browser)
# ------------------------------------
# This key bypasses all Row Level Security. Only use in server
# components, API routes, and server actions. Never import
# in client components or expose via NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------
# Application
# ------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DUMPR
